<!doctype html><html lang="en-GB"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Audio / Control / R&D | Event Tech Research Ltd</title><meta name="description" content="London-based event engineering, networked audio, control systems and research-led technology from Event Tech Research Ltd."><meta name="theme-color" content="#080808"><style>*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:90px}body{margin:0;background:#080808;color:#f5f5f2;font-family:Arial,Helvetica,sans-serif}a{color:inherit;text-decoration:none}button{font:inherit}a:focus-visible,button:focus-visible{outline:2px solid #b9e3ff;outline-offset:6px}.skip{position:absolute;top:-80px}.skip:focus{top:10px;z-index:10;background:#fff;color:#000;padding:15px}.wrap{max-width:1540px;margin:auto;padding:0 5vw}header{border-bottom:1px solid #333;background:#080808;position:sticky;top:0;z-index:5}.nav{height:88px;display:flex;align-items:center;justify-content:space-between}.brand{display:flex;gap:15px;align-items:center}.mark{font-weight:950;font-size:39px;letter-spacing:-3px}.brand small{font:10px/1.5 'Courier New',monospace;letter-spacing:1px;text-transform:uppercase;border-left:1px solid #555;padding-left:15px}nav{display:flex;gap:27px;align-items:center;font:11px 'Courier New',monospace;text-transform:uppercase;letter-spacing:1px}nav a:hover,nav a[aria-current=page]{text-decoration:underline;text-underline-offset:7px}.navcontact{border:1px solid #666;padding:13px 17px}.menu{display:none;color:white;background:none;border:1px solid #666;padding:10px}.hero{position:relative;isolation:isolate;min-height:720px;padding:55px 0 36px;display:flex;flex-direction:column;justify-content:space-between}.hero:before{content:'';position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,transparent 0%,#08080822 55%,#080808 100%),none center top/cover no-repeat}.eyebrow,.meta,.num,.tag{font:11px/1.6 'Courier New',monospace;text-transform:uppercase;letter-spacing:1.8px}.eyebrow{display:flex;gap:12px;align-items:center}.cross{font-size:21px}.hero h1{font-size:clamp(64px,8.3vw,140px);line-height:.91;letter-spacing:-.065em;margin:100px 0 32px;max-width:1150px;font-weight:950}.muted{color:#999}.herofoot{display:flex;justify-content:space-between;align-items:end;gap:40px}.lede{font-size:18px;line-height:1.6;max-width:510px;color:#c3c3c3}.button{display:inline-flex;gap:40px;justify-content:space-between;padding:18px 22px;border:1px solid #aaa;font:12px 'Courier New',monospace;text-transform:uppercase;letter-spacing:1px}.button.light{background:#f5f5f2;color:#080808;border-color:#f5f5f2}.button:hover{background:#b9e3ff;color:#080808}.strip{border-top:1px solid #444;border-bottom:1px solid #444;display:flex;justify-content:space-between;padding:20px 0;gap:15px}.section{padding:95px 0;border-bottom:1px solid #333}.sectionhead{display:grid;grid-template-columns:1fr 2fr;gap:50px;margin-bottom:48px}h2{font-size:clamp(35px,4vw,62px);line-height:1.05;letter-spacing:-.045em;margin:0;font-weight:900}h3{font-size:29px;letter-spacing:-1px;line-height:1.1;margin:15px 0}p{line-height:1.65;color:#aaa}.service{display:grid;grid-template-columns:80px 1fr 1fr 35px;gap:25px;align-items:start;padding:33px 0;border-top:1px solid #333}.service h3{margin:0}.service p{margin:0}.arrow{font-size:27px}.projects{display:grid;grid-template-columns:1fr 1fr;gap:28px}.project{border:1px solid #333;display:flex;flex-direction:column}.visual{height:270px;background:#111;position:relative;overflow:hidden;padding:32px;display:flex;align-items:center;justify-content:center}.scope{width:100%;display:grid;grid-template-columns:repeat(8,1fr);gap:5px;transform:perspective(700px) rotateY(-12deg) rotateX(9deg)}.channel{height:145px;border:1px solid #555;padding:8px;font:9px monospace;color:#888;display:flex;flex-direction:column;justify-content:space-between}.meter{height:70%;width:40%;background:repeating-linear-gradient(to top,#aaa 0 5px,tran