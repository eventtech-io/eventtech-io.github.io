/* Material, framing and engineering details */
body{background:#070707;position:relative}body:before{content:"";position:fixed;inset:0;pointer-events:none;z-index:8;background:none center/900px auto;opacity:.045;mix-blend-mode:screen}.wrap{padding-left:5.7vw;padding-right:5.7vw}header{background:rgba(6,6,6,.97);border-bottom-color:#444}.nav{height:94px}.brand small{letter-spacing:1.4px;line-height:1.6}nav{gap:33px;font-size:12px}.edge-label{position:fixed;top:145px;left:17px;writing-mode:vertical-rl;transform:rotate(180deg);font:9px/1 monospace;letter-spacing:2px;color:#777;z-index:4;pointer-events:none}.hero{min-height:740px;padding-top:45px}.hero:after{content:"+";position:absolute;bottom:26px;left:17px;color:#999;font:20px monospace}.hero-grid{display:grid;grid-template-columns:minmax(0,1fr) 205px;gap:50px;align-items:center}.hero h1{font-family:Impact,'Arial Black',Arial,sans-serif;font-weight:900;font-size:clamp(68px,7.8vw,132px);letter-spacing:-.045em;margin-top:95px;margin-bottom:35px;line-height:.94}.herofoot{gap:20px}.herofoot .lede{max-width:400px;font-size:17px}.herofoot .button{gap:25px;white-space:nowrap}.hero h1,.pagehero h1{color:#eee;background-image:linear-gradient(#ffffffb8,#ffffffb8),none;background-size:auto,700px;-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}.engineering-rail{border-left:1px solid #ffffff33;padding-left:24px;align-self:stretch;display:flex;flex-direction:column;padding-top:80px;position:relative}.engineering-rail:before,.engineering-rail:after{content:"+";position:absolute;left:-6px;color:#999;font:17px monospace}.engineering-rail:before{top:65px}.engineering-rail:after{bottom:0}.engineering-rail .meta{font-size:9px;letter-spacing:1.2px;color:#aaa}.motif-frame{position:relative;border:1px solid #ffffff55;margin:15px 0;padding:10px;color:#d7d7d7}.motif-frame svg{display:block;width:100%;height:auto}.rail-bottom{margin-top:auto;padding-top:80px;display:flex;flex-direction:column;gap:13px}.rail-bottom svg{width:75px;height:75px}.section{position:relative;border-bottom-color:#444}.section:before{content:"+";position:absolute;top:-9px;left:-7px;font:18px monospace;color:#888}.sectionhead .eyebrow{letter-spacing:2px}.sectionhead h2{font-weight:900;letter-spacing:-.055em}.strip{border:1px solid #555;padding:0;gap:0}.strip>span{flex:1;padding:19px 20px;border-right:1px solid #444}.strip>span:last-child{border-right:0}.projects{gap:0;border-left:1px solid #444;border-top:1px solid #444;grid-template-columns:repeat(3,minmax(0,1fr))}.project{border:0;border-right:1px solid #444;border-bottom:1px solid #444;min-width:0}.projectbody{padding:26px}.projectbody h3{font-size:34px}.projectbody .tag{font-size:10px;letter-spacing:1.2px}.projectbody .button{width:100%;padding:15px;gap:10px;font-size:10px}.visual{height:235px}.visual:after{content:"+";position:absolute;right:12px;top:9px;color:#aaa;font:20px monospace}.project:first-child .visual:after{display:none}.project p{font-size:15px}.service{padding:35px 0}.service:hover h3{color:#ddd}.contact{background:linear-gradient(#070707ed,#070707ed),none center/cover;color:#f4f4f0;border-top:1px solid #555;border-bottom:1px solid #555;position:relative}.contact .wrap{position:relative}.contact .wrap:before{content:"+";position:absolute;top:0;right:5.7vw;color:#aaa;font:24px monospace}.contact h2{font-family:Impact,'Arial Black',Arial,sans-serif;font-weight:900;line-height:.95;letter-spacing:-.035em}.contact p{color:#bbb}.contact .button{border-color:#aaa}.button{position:relative;transition:background .15s,color .15s}.button.light{background:transparent;color:#fff;border-color:#aaa}.button:hover,.button.light:hover{background:#eee;color:#080808}.studio-band{border:1px solid #444;border-top:0;display:grid;grid-template-columns:repeat(4,1fr)}.studio-band>span{padding:25px 16px;border-right:1px solid #444;font-size:9px;letter-spacing:1px;color:#aaa}.studio-band>span:last-child{border:0;color:#eee}.pagehero{position:relative;border-bottom:1px solid #444;margin-bottom:35px}.pagehero:after{content:"+";position:absolute;bottom:-10px;right:0;color:#999;font:20px monospace}.pagehero h1{font-family:Impact,'Arial Black',Arial,sans-serif;letter-spacing:-.025em;line-height:.97}.sd-showcase,.sd-gallery figure{position:relative}.sd-showcase:before{content:"+";position:absolute;left:12px;top:10px;font:22px monospace;color:#ddd}.sd-vivid-copy h3{font-family:Impact,'Arial Black',Arial,sans-serif;font-size:clamp(32px,3.3vw,48px);letter-spacing:-.02em}.sd-gallery{border:0}.sd-features article h3{font-size:26px}
