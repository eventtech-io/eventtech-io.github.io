/* Clear, consistent display typography across platforms. */
.hero h1,.pagehero h1,.contact h2,.sd-vivid-copy h3{font-family:Arial,Helvetica,sans-serif;font-weight:700;letter-spacing:-.025em;line-height:1.08;background:none;-webkit-text-fill-color:currentColor;color:#f5f5f2}
.hero h1{font-size:clamp(60px,6.3vw,104px)}
.pagehero h1{font-size:clamp(52px,7vw,96px)}
h2,.sectionhead h2{letter-spacing:-.025em;line-height:1.12}h3{letter-spacing:-.015em;line-height:1.2}
.contact h2{font-size:clamp(48px,6vw,92px)}
.sd-vivid-copy h3{font-size:clamp(28px,3vw,40px)}
@media(max-width:760px){.hero h1{font-size:clamp(43px,9.3vw,70px);line-height:1.1;letter-spacing:-.025em}.pagehero h1{font-size:clamp(42px,9vw,68px)}.contact h2{font-size:clamp(40px,8.5vw,66px)}}

.ns-player{position:relative;aspect-ratio:16/11;background:#090909;border:1px solid #444}.ns-player iframe{position:absolute;inset:0;width:100%;height:100%;border:0}.ns-film-footer{display:flex;justify-content:space-between;gap:25px;align-items:center;margin-top:20px}.ns-film-footer p{max-width:600px;font-size:14px}.ns-film-footer .button{white-space:nowrap;font-size:11px}.ns-figure{margin:35px 0 0}.ns-figure img{display:block;width:100%;height:auto;border:1px solid #444}.ns-figure figcaption{font:11px/1.6 monospace;color:#aaa;padding:15px 0}.ns-resources{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #444;border-left:1px solid #444}.ns-resources>a{padding:30px;border-right:1px solid #444;border-bottom:1px solid #444}.ns-resources>a:hover{background:#141414}.ns-resources h3{font-size:26px}.ns-resources .meta{font-size:10px}.ns-card{padding:0}.ns-card img{width:100%;height:100%;object-fit:cover;object-position:center}.ns-card:after{display:none}@media(max-width:760px){.ns-player{aspect-ratio:4/3}.ns-film-footer{align-items:start;flex-direction:column;gap:5px}.ns-resources{grid-template-columns:1fr}.ns-resources>a{padding:25px}}

.projects{grid-template-columns:repeat(2,minmax(0,1fr))}.project.project-featured,.project.project-featured:first-child{grid-column:1/-1;display:grid;grid-template-columns:minmax(0,1.6fr) minmax(280px,1fr)}.project-featured .ns-card{height:100%;min-height:380px!important;background:#080808}.project-featured .ns-card img{object-fit:contain}.project-featured .projectbody{padding:40px;display:flex;flex-direction:column;justify-content:center}.project-featured .projectbody h3{font-size:clamp(36px,4vw,60px)}.project-featured .projectbody .button{width:fit-content;margin-top:20px;min-width:200px}.project-featured .projectbody p{font-size:17px}.project-featured .projectbody .tag{color:#a7d9d2}@media(max-width:760px){.projects{grid-template-columns:1fr}.project.project-featured,.project.project-featured:first-child{display:flex;flex-direction:column;grid-column:auto}.project-featured .ns-card{min-height:0!important;height:auto!important;aspect-ratio:1363/939}.project-featured .projectbody{padding:25px}.project-featured .projectbody p{font-size:15px}}
/* Cinematic urban backdrops, with solid contrast beneath all copy. */
body{background:#060606}body:before{opacity:.085;background-size:1100px auto;z-index:0}header,main,footer,.studio-band{position:relative}header{z-index:5}main,footer,.studio-band{z-index:1}.pagehero{isolation:isolate;overflow:hidden;padding-top:95px;padding-bottom:70px}.pagehero:before{content:"";position:absolute;z-index:-1;inset:0 -2vw;background:linear-gradient(90deg,#060606 5%,#060606e8 32%,#06060688 68%,#0606063d),linear-gradient(0deg,#060606 0%,#06060600 40%,#06060655),none 65% center/cover no-repeat;filter:grayscale(1)}.pagehero h1{max-width:1000px}.pagehero .lede{color:#c9c9c9}.contact{background:linear-gradient(90deg,#050505f5,#050505d9 45%,#0505058c),linear-gradient(0deg,#050505cc,#05050555),none center 62%/cover no-repeat}.contact:before{content:"";position:absolute;inset:0;background:#0003;pointer-events:none}.section{background:linear-gradient(90deg,#070707e8,#070707d9)}.section:nth-of-type(3n){background:linear-gradient(100deg,#070707f5,#070707d9),none center/cover no-repeat}.hero:before{background:linear-gradient(180deg,#03040500 0%,#06060611 50%,#060606 100%),none center top/cover no-repeat}.hero .hero-primary{position:relative}.hero-primary:before{content:"";position:absolute;z-index:-1;inset:10% -20px -20px;background:linear-gradient(90deg,#02030533,transparent);pointer-events:none}.ns-resources>a,.projectbody{background:#080808bf}.sd-features article,.sd-steps article{background:linear-gradient(180deg,#08080888,transparent)}
@media(max-width:760px){.pagehero{padding-top:65px;padding-bottom:50px}.pagehero:before{background:linear-gradient(90deg,#060606ed,#060606a3),linear-gradient(0deg,#060606,transparent),none 60% center/cover no-repeat}.contact{background:linear-gradient(#050505dd,#050505ed),none center/cover no-repeat}}
/* Each photographic background has one placement, with no repeated footer image. */
body:before{display:none}.section,.section:nth-of-type(3n){background:none}.contact{background:linear-gradient(125deg,#111,#060606 70%)}.contact:before{display:none}.pagehero:before{background:radial-gradient(ellipse at 85% 40%,#1a1a1a,transparent 65%);filter:none}.page-technology .pagehero:before{background:linear-gradient(90deg,#060606f5,#060606a6 50%,#06060655),linear-gradient(0deg,#060606,transparent 65%),none 65% center/cover no-repeat;filter:grayscale(1)}.page-services .pagehero:before{background:linear-gradient(90deg,#060606f5,#06060699 55%,#06060644),linear-gradient(0deg,#060606,transparent 65%),none right center/cover no-repeat}.page-about .pagehero:before{background:linear-gradient(90deg,#060606fa,#060606b3 45%,#06060633),linear-gradient(0deg,#060606,transparent 65%),none right 35%/auto 130% no-repeat}.page-nodescope .pagehero:before{background:linear-gradient(90deg,#060606,transparent),repeating-linear-gradient(90deg,transparent 0 32px,#75b8ab20 32px 33px,transparent 33px 65px),radial-gradient(ellipse at 85% 60%,#102320,transparent 65%)}.page-superdave .pagehero:before{background:linear-gradient(90deg,#060606 15%,#06060644),radial-gradient(ellipse at 90% 45%,#781d5a66,transparent 45%),radial-gradient(ellipse at 60% 65%,#007f9a55,transparent 45%)}.page-hedera .pagehero:before{background:linear-gradient(90deg,#060606 15%,#06060655),repeating-radial-gradient(ellipse at 95% 55%,transparent 0 44px,#ffffff15 45px 46px,transparent 47px 80px)}.page-contact .pagehero:before{background:linear-gradient(90deg,#060606,transparent),repeating-linear-gradient(135deg,transparent 0 80px,#ffffff08 81px 82px,transparent 83px 160px)}
@media(max-width:760px){.page-about .pagehero:before{background:linear-gradient(90deg,#060606ed,#06060677),none 65% center/cover no-repeat}.page-services .pagehero:before{background:linear-gradient(90deg,#060606ed,#06060688),none center/cover no-repeat}.page-technology .pagehero:before{background:linear-gradient(90deg,#060606ee,#06060699),none center/cover no-repeat}}

/* Client stories follow the shared editorial model. */
.page-about .pagehero:before{background:linear-gradient(115deg,#060606,transparent),repeating-linear-gradient(145deg,transparent 0 90px,#ffffff09 91px 92px,transparent 93px 180px)}.page-clients .pagehero:before{background:linear-gradient(90deg,#060606,transparent),radial-gradient(ellipse at 85% 50%,#252525,transparent 65%)}.page-dmc .pagehero:before{background:linear-gradient(90deg,#060606,transparent),repeating-linear-gradient(90deg,transparent 0 100px,#ffffff09 101px 102px,transparent 103px 180px)}.client-feature{display:grid;grid-template-columns:1fr 1.3fr;gap:55px;align-items:center;border:1px solid #444;padding:45px}.client-wordmark{font:700 clamp(75px,11vw,180px)/1 Arial,sans-serif;letter-spacing:-.06em}.client-wordmark span{display:block;font:11px/1.6 monospace;letter-spacing:3px;margin-top:18px}.client-feature h2{font-size:40px;margin:20px 0}.client-feature:hover{background:#141414}.dmc-photo{margin:0}.dmc-photo img{display:block;width:100%;max-height:720px;object-fit:cover;object-position:center 45%;border:1px solid #444}.dmc-photo figcaption{font:11px/1.6 monospace;color:#aaa;padding:15px 0}.dmc-grid{display:grid;grid-template-columns:1fr 1fr;gap:35px}.dmc-contribution,.dmc-grid>article{border-top:1px solid #444;padding-top:24px}.dmc-grid h3{font-size:26px}.dmc-signal{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid #444}.dmc-signal>div{padding:25px;border-right:1px solid #444}.dmc-signal>div:last-child{border:0}.dmc-signal h3{font-size:22px}.dmc-note{font-size:13px;color:#aaa;border-left:1px solid #555;padding-left:20px;margin-top:30px}nav{gap:25px}@media(max-width:760px){.client-feature{grid-template-columns:1fr;padding:25px;gap:30px}.client-feature h2{font-size:32px}.dmc-grid{grid-template-columns:1fr}.dmc-signal{grid-template-columns:1fr 1fr}.dmc-signal>div:nth-child(-n+2){border-bottom:1px solid #444}.dmc-signal>div:nth-child(2){border-right:0}.dmc-photo img{max-height:none;height:auto}.page-about .pagehero:before{background:radial-gradient(ellipse at right,#222,transparent 70%)}}

/* Distinct reference imagery: one placement per photograph. */
.page-services .pagehero:before{background:linear-gradient(90deg,#060606f5,#060606bb 50%,#06060655),none center top/cover no-repeat}.page-about .pagehero:before{background:linear-gradient(90deg,#060606f5,#06060699 60%,#06060655),none center/cover no-repeat}.page-clients .pagehero:before{background:linear-gradient(90deg,#060606ed,#060606cc),none center/cover no-repeat}.page-dmc .dmc-hero:before{display:none}.dmc-hero{display:grid;grid-template-columns:1.1fr 1fr;gap:45px;align-items:center;padding:55px 0!important;overflow:visible}.dmc-hero h1{font-size:clamp(46px,5vw,76px);letter-spacing:-.035em}.dmc-hero .lede{font-size:17px}.dmc-hero .dmc-photo{min-width:0}.dmc-hero .dmc-photo img{height:570px;max-height:none;object-fit:cover;object-position:47% center}.dmc-hero figcaption{font-size:10px}.dmc-hero .button{font-size:11px}@media(max-width:760px){.dmc-hero{grid-template-columns:1fr;gap:30px;padding:45px 0!important}.dmc-hero h1{font-size:clamp(42px,9.8vw,68px)}.dmc-hero .dmc-photo img{height:auto;max-height:650px}.page-services .pagehero:before{background:linear-gradient(90deg,#060606ed,#060606aa),none center top/cover no-repeat}.page-about .pagehero:before{background:linear-gradient(90deg,#060606ed,#060606aa),none center/cover no-repeat}}

/* Larger photographic canvases with a quieter area behind copy. */
.page-services .pagehero,.page-about .pagehero,.page-technology .pagehero,.page-clients .pagehero{min-height:76svh;display:flex;flex-direction:column;justify-content:center;padding-top:110px;padding-bottom:110px;overflow:visible}
.page-services .pagehero:before,.page-about .pagehero:before,.page-technology .pagehero:before,.page-clients .pagehero:before{inset:0 -5.7vw;background-size:cover;background-repeat:no-repeat}
.page-services .pagehero:before{background-image:linear-gradient(90deg,#060606e8 0%,#060606b3 37%,#06060622 78%),linear-gradient(0deg,#060606aa,transparent 30%),none;background-position:center}
.page-about .pagehero:before{background-image:linear-gradient(90deg,#060606ed 0%,#060606b3 38%,#06060622 80%),linear-gradient(0deg,#06060699,transparent 30%),none;background-position:center}
.page-technology .pagehero:before{background-image:linear-gradient(90deg,#060606eb 0%,#060606aa 40%,#06060611 80%),linear-gradient(0deg,#060606aa,transparent 30%),none;background-position:65% center}
.page-clients .pagehero:before{background-image:linear-gradient(90deg,#060606de,#06060688),none}
.page-services .pagehero .lede,.page-about .pagehero .lede,.page-technology .pagehero .lede{max-width:580px;text-shadow:0 2px 12px #000}
.dmc-hero{grid-template-columns:1fr 1.3fr;min-height:78svh}.dmc-hero .dmc-photo img{height:clamp(570px,72svh,850px)}
@media(max-width:760px){.page-services .pagehero,.page-about .pagehero,.page-technology .pagehero,.page-clients .pagehero{min-height:70svh;padding-top:75px;padding-bottom:75px}.page-services .pagehero:before,.page-about .pagehero:before,.page-technology .pagehero:before,.page-clients .pagehero:before{inset:0 -6vw}.pagehero .lede{font-size:16px}.dmc-hero{grid-template-columns:1fr;min-height:0}.dmc-hero .dmc-photo img{height:auto;max-height:none}}

/* Explicit image element keeps the circuit independent of CSS variable limits. */
.hero{min-height:max(800px,calc(100svh - 94px));overflow:hidden}.hero:before{display:none}.circuit-backdrop{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-1}.hero-grid{position:relative}.hero-primary{background:linear-gradient(90deg,#050505b8,transparent);padding:25px 0}.hero h1{text-shadow:0 2px 20px #000}.hero .lede{text-shadow:0 2px 8px #000}.atmosphere{margin:70px 0;display:grid;grid-template-columns:1fr 1fr;gap:24px}.atmosphere figure{margin:0;overflow:hidden;border:1px solid #444}.atmosphere img{display:block;width:100%;height:400px;object-fit:cover}.atmosphere figcaption{padding:14px 18px;font:11px/1.5 monospace;color:#aaa;background:#080808}@media(max-width:760px){.hero{min-height:740px}.atmosphere{grid-template-columns:1fr;gap:20px;margin:45px 0}.atmosphere img{height:280px}}

.atmosphere{grid-template-columns:1fr}.atmosphere img{height:clamp(320px,48vw,600px)}@media(max-width:760px){.atmosphere img{height:280px}}
/* Consistent project rows: equal artwork, copy start and action baseline. */
.projects{align-items:stretch}.projects .project:not(.project-featured){display:flex;flex-direction:column}.projects .project:not(.project-featured) .visual{height:300px!important;min-height:300px!important;max-height:300px;flex:0 0 300px;overflow:hidden}.projects .project:not(.project-featured) .visual img{width:100%;height:100%;object-fit:contain}.projects .project:not(.project-featured) .projectbody{display:flex;flex-direction:column;flex:1;padding:28px}.projects .project:not(.project-featured) .projectbody h3{margin:14px 0 16px}.projects .project:not(.project-featured) .projectbody p{margin:0 0 28px}.projects .project:not(.project-featured) .projectbody .button{margin-top:auto;width:100%;min-height:48px}.projectbody .tag{min-height:16px}.ns-resources>a{display:flex;flex-direction:column}.ns-resources>a .button{margin-top:auto}img{max-width:100%}.sd-ui-crop img{max-width:none}.sectionhead{align-items:start}.aboutgrid>*,.sectionhead>*,.projects>*,.client-feature>*{min-width:0}@media(max-width:760px){.projects .project:not(.project-featured) .visual{height:260px!important;min-height:260px!important;max-height:260px;flex-basis:260px}.projects .project:not(.project-featured) .projectbody{padding:25px}.projectbody .button{white-space:normal}.foot{overflow-wrap:anywhere}}

/* Homepage atmosphere echoes the blue-cyan circuit hero. */
.page-home .atmosphere figure{background:#091b2a;border-color:#284859}.page-home .atmosphere img{filter:sepia(1) saturate(1.45) hue-rotate(155deg) brightness(.92);}.page-home .atmosphere figcaption{background:#08121c;color:#9bbbcf;border-top:1px solid #284859}

/* Atmospheric scenes are decoration behind content, never feature panels. */
.themed-section{position:relative;isolation:isolate;overflow:hidden;background:#080b0e!important}.themed-section>.theme-background{position:absolute;inset:0;width:100%;height:100%;max-width:none;object-fit:cover;opacity:.28;z-index:-2;pointer-events:none;filter:grayscale(1)}.themed-section:after{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;background:linear-gradient(90deg,rgba(5,8,11,.88),rgba(5,8,11,.60) 55%,rgba(5,8,11,.22))}.page-home .themed-section>.theme-background{filter:sepia(1) saturate(1.45) hue-rotate(155deg) brightness(.92);opacity:.38}.themed-section .projectbody{background:#080808ed}.contact.themed-section{padding-top:85px;padding-bottom:85px}@media(max-width:760px){.themed-section>.theme-background{opacity:.23}.themed-section:after{background:linear-gradient(90deg,#05080be8,#05080b88)}.contact.themed-section{padding-top:60px;padding-bottom:60px}}

/* Every content image is now a decorative background. */
.background-content{position:relative;isolation:isolate;overflow:hidden}.background-content>.content-backdrop{position:absolute!important;inset:0;width:100%!important;height:100%!important;max-width:none!important;margin:0!important;object-fit:cover!important;opacity:.20;z-index:-1;pointer-events:none}.background-content{background:#080b0f}.background-content:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#05080bdd,#05080b33);z-index:-1;pointer-events:none}.projects .project,.projects .project.project-featured,.projects .project.project-featured:first-child{display:flex;flex-direction:column;min-height:330px}.projects .project .projectbody{background:transparent!important;flex:1;display:flex;flex-direction:column;padding:32px}.projects .project .projectbody .button{margin-top:auto}.projects .project-featured .projectbody p{max-width:650px}.projects .project-featured{min-height:360px}.projects .project:last-child{background:radial-gradient(ellipse at right,#1b262c,#080b0f 75%)}.dmc-hero{display:block!important;min-height:620px;padding:90px 0!important}.dmc-hero>div{max-width:660px}.sd-vivid{display:block}.sd-vivid-copy{max-width:720px;padding:25px 0}.background-content .theme-background{opacity:.15}.page-home .content-backdrop{filter:sepia(.5) saturate(.8) hue-rotate(155deg)}@media(max-width:760px){.dmc-hero{min-height:0;padding:65px 0!important}.projects .project .projectbody{padding:25px}.projects .project,.projects .project-featured{min-height:300px}}
/* Small visibility lift for decorative backgrounds. */
.themed-section>.theme-background{opacity:.38}.page-home .themed-section>.theme-background{opacity:.48}.background-content>.content-backdrop{opacity:.29}.background-content .theme-background{opacity:.24}.themed-section:after{background:linear-gradient(90deg,rgba(5,8,11,.80),rgba(5,8,11,.50) 55%,rgba(5,8,11,.14))}@media(max-width:760px){.themed-section>.theme-background{opacity:.32}.page-home .themed-section>.theme-background{opacity:.40}.background-content>.content-backdrop{opacity:.26}.themed-section:after{background:linear-gradient(90deg,#05080bd9,#05080b70)}}

/* Product visuals are feature content, displayed at full brightness. */
.projects .project .visual img,.page-nodescope .ns-figure img,.page-superdave .sd-showcase>img,.page-superdave .sd-gallery img,.page-superdave .sd-figure img{opacity:1;filter:none}.projects .project .projectbody{background:#080808!important}.projects .project.project-featured,.projects .project.project-featured:first-child{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(280px,1fr);min-height:380px}.projects .project.project-featured .visual{height:100%;min-height:380px!important}.projects .project .projectbody .button{margin-top:auto}.projects .project:not(.project-featured) .visual{height:300px!important;min-height:300px!important}.sd-showcase>img{position:static;display:block;width:100%;max-height:850px;object-fit:contain}.sd-vivid{display:grid;grid-template-columns:1.2fr .8fr}.sd-vivid-copy{padding:25px}@media(max-width:760px){.projects .project.project-featured,.projects .project.project-featured:first-child{display:flex;flex-direction:column}.projects .project.project-featured .visual{height:auto;min-height:0!important;aspect-ratio:1363/939}.sd-vivid{grid-template-columns:1fr}.sd-vivid-copy{padding:15px 0}}
/* DMC client box has a solid black ground. */
.client-feature,.client-feature:hover{background:#000!important;color:#fff}.client-wordmark{background:#000;color:#fff}.dmc-anime{margin:0;background:#000;border:1px solid #333}.dmc-anime img{display:block;width:100%;height:auto;opacity:1;filter:none}.dmc-anime figcaption{padding:12px 20px;color:#aaa;font:11px/1.5 monospace}

/* Original DMC photo is a leading editorial feature. */
.page-dmc .dmc-hero{display:grid!important;grid-template-columns:minmax(0,.9fr) minmax(0,1.25fr);gap:48px;align-items:center;min-height:740px;padding:55px 0!important;background:#050505;overflow:visible}.page-dmc .dmc-hero:after{display:none}.page-dmc .dmc-feature-photo{position:static!important;grid-column:2;grid-row:1;display:block;width:100%;height:720px;max-height:82svh;object-fit:cover;object-position:48% center;opacity:1!important;filter:none!important;border:1px solid #333}.page-dmc .dmc-hero-copy{grid-column:1;grid-row:1;max-width:none}.page-dmc .dmc-hero h1{font-size:clamp(44px,4.8vw,78px)}@media(max-width:760px){.page-dmc .dmc-hero{grid-template-columns:1fr;gap:28px;min-height:0;padding:45px 0!important}.page-dmc .dmc-hero-copy{grid-column:1;grid-row:1}.page-dmc .dmc-feature-photo{grid-column:1;grid-row:2;height:auto;max-height:none;object-fit:contain}.page-dmc .dmc-hero h1{font-size:clamp(42px,9vw,68px)}}

.manga-background-section>.theme-background{opacity:.32;object-position:center 40%}.manga-background-section:after{background:linear-gradient(90deg,#050505ef,#050505b8 65%,#05050570)}
/* DMC original hero: brighter blue-cyan backdrop, with protected copy. */
.page-dmc .dmc-hero{display:flex!important;flex-direction:column;align-items:flex-start;justify-content:center;min-height:740px;padding:80px 35px!important;overflow:hidden;background:#06101b}.page-dmc .dmc-feature-photo{position:absolute!important;inset:0;width:100%;height:100%;max-height:none;object-fit:cover;object-position:60% center;opacity:.85!important;filter:grayscale(1) sepia(1) saturate(1.45) hue-rotate(155deg) brightness(1.12)!important;z-index:-2;border:0}.page-dmc .dmc-hero:after{display:block;content:"";position:absolute;inset:0;background:linear-gradient(90deg,#030a12d9 0%,#030a1299 38%,#030a1222 78%);z-index:-1}.page-dmc .dmc-hero-copy{max-width:620px}.page-dmc .dmc-hero h1{font-size:clamp(44px,5vw,80px)}@media(max-width:760px){.page-dmc .dmc-hero{min-height:650px;padding:55px 22px!important}.page-dmc .dmc-feature-photo{height:100%;object-fit:cover;object-position:57% center}.page-dmc .dmc-hero-copy{max-width:100%}}
/* Continuous canvas: shading belongs to the section, never a copy rectangle. */
body{background:#060606}.hero{background:#060606}.hero-primary,.hero-primary:before{background:none!important}.hero-primary:before{display:none}.hero:before{display:block;content:"";position:absolute;inset:0;z-index:-1;background:radial-gradient(ellipse at 20% 62%,#02060b65,transparent 72%);pointer-events:none}.circuit-backdrop{z-index:-2;mask-image:linear-gradient(to bottom,#000 0%,#000 78%,transparent 100%);-webkit-mask-image:linear-gradient(to bottom,#000 0%,#000 78%,transparent 100%)}
.themed-section,.background-content{background:#060606!important;border-top-color:transparent;border-bottom-color:transparent}.theme-background,.content-backdrop,.dmc-feature-photo{mask-image:linear-gradient(to bottom,transparent 0%,#000 17%,#000 80%,transparent 100%);-webkit-mask-image:linear-gradient(to bottom,transparent 0%,#000 17%,#000 80%,transparent 100%)}
.themed-section:after,.background-content:after{mask-image:linear-gradient(to bottom,transparent,#000 17%,#000 80%,transparent);-webkit-mask-image:linear-gradient(to bottom,transparent,#000 17%,#000 80%,transparent)}
.pagehero{border-bottom-color:transparent;margin-bottom:0}.pagehero:before{mask-image:linear-gradient(to bottom,#000 0%,#000 72%,transparent 100%);-webkit-mask-image:linear-gradient(to bottom,#000 0%,#000 72%,transparent 100%)}.pagehero:after{color:transparent}.section{border-bottom-color:#ffffff15}.contact.themed-section{border-top:0;border-bottom:0}.page-dmc .dmc-hero{background:#060606}.page-dmc .dmc-hero:after{mask-image:linear-gradient(to bottom,#000 0%,#000 80%,transparent);-webkit-mask-image:linear-gradient(to bottom,#000 0%,#000 80%,transparent)}
.client-feature,.client-feature:hover,.client-wordmark{background:#000!important}.projects .visual img,.sd-showcase img,.sd-gallery img,.ns-figure img,.sd-figure img{mask-image:none;-webkit-mask-image:none}
</style><link rel="icon" href="data:image/png;base64,"></head><body class="page-index page-home"><a class="skip" href="#main">Skip to content</a><header><div class="wrap nav"><a class="brand" href="index.html" aria-label="Event Tech Research home"><img class="official-logo" src="data:image/png;base64," alt="Event Tech Research Ltd logo" width="54" height="54"><small>Event Tech<br>Research Ltd</small></a><button class="menu" aria-expanded="false" aria-controls="navigation">Menu +</button><nav id="navigation"><a href="services.html" >Services</a><a href="technology.html" >Technology</a><a href="clients.html">Clients</a><a href="about.html" >About</a><a href="contact.html" >Contact</a></nav></div></header><div class="edge-label" aria-hidden="true">EVENT TECH RESEARCH / AUDIO · CONTROL · R&D</div><main id="main"><section class="hero"><img class="circuit-backdrop" src="data:image/png;base64," alt="" aria-hidden="true" fetchpriority="high"><div class="wrap hero-grid" style="width:100%"><div class="hero-primary"><div class="eyebrow"><span class="cross">+</span> Independent engineering / London</div><h1>REAL SYSTEMS.<br>LIVE THINKING.</h1><div class="herofoot"><p class="lede">Research-led audio, control and technology.<br>Built around the people behind the show.</p><a class="button light" href="services.html">Explore our work <span>↗</span></a></div></div><aside class="engineering-rail" aria-label="Engineering disciplines"><span class="meta">SIGNAL / SYSTEMS</span><div class="motif-frame"><svg viewBox="0 0 190 80" fill="none" stroke="currentColor" stroke-width=".8" aria-hidden="true"><path d="M6 39.8v0.4"/><path d="M9 36.9v6.2"/><path d="M12 38.9v2.2"/><path d="M15 37.8v4.4"/><path d="M18 36.0v8.0"/><path d="M21 31.0v17.9"/><path d="M24 31.5v17.1"/><path d="M27 34.5v11.1"/><path d="M30 37.1v5.8"/><path d="M33 34.0v12.0"/><path d="M36 22.0v36.1"/><path d="M39 35.0v10.0"/><path d="M42 25.4v29.2"/><path d="M45 37.2v5.7"/><path d="M48 25.9v28.1"/><path d="M51 29.4v21.3"/><path d="M54 15.7v48.5"/><path d="M57 26.1v27.8"/><path d="M60 32.9v14.2"/><path d="M63 28.2v23.5"/><path d="M66 24.0v32.1"/><path d="M69 10.3v59.3"/><path d="M72 29.3v21.4"/><path d="M75 26.5v27.0"/><path d="M78 35.8v8.4"/><path d="M81 13.0v54.0"/><path d="M84 29.4v21.1"/><path d="M87 10.4v59.2"/><path d="M90 29.5v21.1"/><path d="M93 32.9v14.2"/><path d="M96 22.3v35.3"/><path d="M99 16.7v46.6"/><path d="M102 12.1v55.8"/><path d="M105 28.5v23.0"/><path d="M108 35.6v8.8"/><path d="M111 33.2v13.6"/><path d="M114 10.0v60.1"/><path d="M117 34.5v10.9"/><path d="M120 18.1v43.7"/><path d="M123 35.2v9.5"/><path d="M126 27.1v25.9"/><path d="M129 25.3v29.5"/><path d="M132 19.4v41.2"/><path d="M135 24.1v31.8"/><path d="M138 33.7v12.5"/><path d="M141 32.3v15.4"/><path d="M144 32.8v14.4"/><path d="M147 21.1v37.8"/><path d="M150 36.9v6.3"/><path d="M153 32.0v16.0"/><path d="M156 38.0v4.0"/><path d="M159 31.2v17.7"/><path d="M162 34.7v10.5"/><path d="M165 32.6v14.9"/><path d="M168 36.8v6.3"/><path d="M171 39.3v1.4"/><path d="M174 38.0v3.9"/><path d="M177 39.1v1.9"/><path d="M0 40H190" opacity=".25"/></svg></div><span class="meta">AUDIO · LED · VIDEO · R&D</span><div class="rail-bottom"><svg viewBox="0 0 80 80" fill="none" stroke="currentColor" stroke-width=".7" aria-hidden="true"><circle cx="40" cy="40" r="34"/><ellipse cx="40" cy="40" rx="17" ry="34"/><ellipse cx="40" cy="40" rx="34" ry="12"/><path d="M6 40h68M40 6v68M12 20q28 12 56 0M12 60q28-12 56 0"/></svg><span class="meta">LONDON<br>FIELD ENGINEERING<br>RESEARCH & DEVELOPMENT</span></div></aside></div></section><div class="wrap"><div class="strip meta"><span>01 / Audio</span><span>02 / Control</span><span>03 / Networking</span><span>04 / Research & development</span></div><section class="themed-section section"><img class="theme-background" src="data:image/jpeg;base64," alt="" aria-hidden="true" loading="lazy"><div class="sectionhead"><span class="eyebrow">+ The practice</span><h2>COMPLEX SYSTEMS.<br>CLEAR INTENT.</h2></div><div class="aboutgrid"><p class="lede">Event Tech Research is a London-based R&D and education studio working across modern event audio, networking and control.</p><p>We connect field engineering with practical research, turning technical problems into useful tools, reliable workflows and documentation that crews can work with.</p></div></section><section class="section" id="services"><div class="sectionhead"><span class="eyebrow">+ Capabilities</span><h2>FROM SIGNAL PATH<br>TO SHOW DAY.</h2></div><a class="service" href="services.html#service-01"><span class="num">01 /</span><h3>Audio engineering</h3><p>Networked audio design, signal paths, system integration and show-day diagnostics.</p><span class="arrow">↗</span></a><a class="service" href="services.html#service-02"><span class="num">02 /</span><h3>Control & networking</h3><p>OSC, device integration and network infrastructure designed around real production workflows.</p><span class="arrow">↗</span></a><a class="service" href="services.html#service-03"><span class="num">03 /</span><h3>Research & development</h3><p>Bespoke software, embedded hardware and practical prototypes for difficult event challenges.</p><span class="arrow">↗</span></a><a class="service" href="services.html#service-04"><span class="num">04 /</span><h3>Documentation & training</h3><p>Clear drawings, operator guides and hands-on handovers that keep systems understandable.</p><span class="arrow">↗</span></a></section><section class="section"><div class="sectionhead"><span class="eyebrow">+ Selected technology</span><h2>RESEARCH THAT<br>LEAVES THE LAB.</h2></div><div class="projects"><article class="project project-featured"><a class="visual ns-card" href="nodescope.html"><img src="data:image/jpeg;base64," alt="NodeScope channel monitoring visual from the product film" loading="lazy"></a><div class="projectbody"><span class="tag">Featured / Software & monitoring</span><h3>NodeScope</h3><p>One operational view of wireless receiver telemetry and Dante channels. RF, battery, audio and faults, with clear timestamps and stale-data awareness.</p><a class="button" href="nodescope.html">Explore NodeScope ↗</a></div></article><article class="project"><a href="superdave.html" class="visual sd-hero-card" style="padding:0;height:300px"><img src="data:image/png;base64,