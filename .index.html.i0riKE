.official-logo{display:block;width:54px;height:54px;background:#fff;border-radius:8px;object-fit:contain}.brand small{font-size:11px}@media(max-width:760px){.official-logo{width:46px;height:46px}.brand small{font-size:9px}}

.sd-concept{margin:0;border:1px solid #333;background:#fff}.sd-concept img{display:block;width:100%;max-height:850px;object-fit:contain}.sd-concept figcaption{background:#080808;padding:18px 22px;color:#aaa}.sd-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:25px;margin-top:45px}.sd-steps article{border-top:1px solid #555;padding-top:22px}.sd-steps h3{font-size:23px}.sd-features{display:grid;grid-template-columns:1fr 1fr;gap:35px;margin-top:40px}.sd-features article{border-top:1px solid #444;padding-top:15px}.sd-figure{margin:40px 0 0}.sd-figure figcaption{color:#aaa;font:11px/1.6 monospace;padding:15px 0}.sd-ui-crop{overflow:hidden;background:#efeee9;border:1px solid #444}.sd-ui-crop img{display:block;width:117.2414%;max-width:none;margin-left:-17.2414%}.sd-lighting-crop{max-height:780px}.sd-hero-card{background:#fff!important}.sd-hero-card img{object-fit:contain!important}@media(max-width:760px){.sd-steps{grid-template-columns:1fr 1fr;gap:22px}.sd-features{grid-template-columns:1fr;gap:20px}.sd-concept img{max-height:650px}.sd-lighting-crop{max-height:none}.sd-steps h3{font-size:21px}}

.sd-showcase{position:relative;border:1px solid #333;background:#090b17}.sd-showcase>img{display:block;width:100%;max-height:850px;object-fit:contain}.sd-showcase-note{padding:20px 25px;display:flex;justify-content:space-between;gap:20px;border-top:1px solid #333;font:10px/1.5 monospace;color:#aaa}.sd-gallery{display:grid;grid-template-columns:1fr 1fr;gap:30px;margin-top:40px}.sd-gallery figure{margin:0;border:1px solid #333}.sd-gallery img{display:block;width:100%;height:auto}.sd-gallery figcaption{padding:18px 25px}.sd-gallery h3{font-size:23px}.sd-gallery p{margin-bottom:0}.sd-hero-card{background:#090b17!important}@media(max-width:760px){.sd-gallery{grid-template-columns:1fr;gap:24px}.sd-showcase-note{flex-direction:column;gap:5px}}
